## Django
DJANGO_ENV=development
# Use 1 for local runserver. If 0, SECURE_SSL_REDIRECT defaults to off but session cookies
# still default to Secure=True — use HTTP-only cookies locally or stay on DEBUG=1.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
# Optional extra hosts (comma-separated). Settings always allow localhost, 127.0.0.1,
# and ngrok free-tier suffixes (.ngrok-free.app / .ngrok-free.dev).
DJANGO_ALLOWED_HOSTS=
DJANGO_TIME_ZONE=UTC

# Only enable when users hit your app over HTTPS (or set 0 behind a TLS-terminating proxy).
# If this is 1 while you only run `runserver` on http://127.0.0.1:8000, the browser gets
# redirected to https://127.0.0.1:8000/... and the dev server will log TLS garbage errors.
DJANGO_SECURE_SSL_REDIRECT=0

# Comma-separated. With DJANGO_DEBUG=1, common Vite :5173 origins (http + https) are added
# for CSRF. Django HTTPS (runserver_plus) + SPA: set VITE_DJANGO_PROXY_TARGET in frontend/.env.
# Production / custom SPA port: set explicitly, e.g. https://app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# For split-origin deployments (SPA host != Django host), set explicit allowed origins.
# In DEBUG, localhost/127.0.0.1 :5173 are auto-added; in non-DEBUG, set this manually.
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Serve the Vite SPA from Django (single origin, one ngrok tunnel) ---
# 1) npm run build in ../frontend (Vite writes to frontend/dist: index.html + assets/)
# 2) DJANGO_SERVE_SPA=1
# 3) Optional: DJANGO_REACT_DIST_DIR if dist is not ../frontend/dist (templates use this;
#    STATICFILES_DIRS additionally includes <dist>/assets)
# DJANGO_REACT_DIST_DIR=/absolute/path/to/frontend/dist
#
# ngrok forwards HTTPS to HTTP — set these so Django trusts the forwarded host/proto:
# DJANGO_USE_X_FORWARDED_HOST=1
# DJANGO_BEHIND_HTTPS_PROXY=1
#
# After you know your ngrok URL, set the full HTTPS origin (scheme + host ngrok shows):
# DJANGO_PUBLIC_ORIGIN=https://YOUR-SUBDOMAIN.ngrok-free.dev
# (Also adds CSRF + CORS trust in DEBUG; enables forwarded-host/proto when HTTPS.)
#
# Free ngrok may show a one-time browser warning on the first *document* load (no custom headers on
# navigation). After "Visit Site", ngrok sets a cookie (~7 days). XHR/fetch to your API include the
# skip header from frontend/index.html + axios defaults.
#
# DJANGO_SERVE_SPA=1
# DJANGO_DISABLE_CORS=1

## Database
# Example (Postgres):
# DATABASE_URL=postgresql://user:pass@localhost:5432/date_scraping?sslmode=disable
DATABASE_URL=

## Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
SCRAPE_ALL_INTERVAL_SECONDS=300
SCRAPER_SESSION_ENABLED=1
SCRAPER_SESSION_CYCLE_INTERVAL_SECONDS=300
SCRAPER_SESSION_MAX_ACTIVE_PER_USER=1
SCRAPER_SESSION_MIN_DURATION_MINUTES=15
SCRAPER_SESSION_MAX_DURATION_MINUTES=1440
SCRAPER_SESSION_PROGRESS_NOTIFY_MINUTES=120
SCRAPER_SESSION_PROGRESS_MIN_DURATION_MINUTES=360
PERFEX_SYNC_INTERVAL_SECONDS=60

## Perfex CRM
PERFEX_SYNC_ENABLED=0
PERFEX_BASE_URL=https://your-perfex.example.com
PERFEX_API_TOKEN=your-token
# Optional JSON dict to include Perfex-required fields (status/source/assigned etc)
# PERFEX_DEFAULTS_JSON={"status":"1","source":"2"}
PERFEX_DEFAULTS_JSON=
PERFEX_TIMEOUT_SECONDS=20

## Google Sheets
GSHEETS_ENABLED=1
GSHEETS_SPREADSHEET_ID=your-spreadsheet-id
GSHEETS_PROSPECTS_RANGE=Prospects!A:E
GSHEETS_LEADS_RANGE=Leads!A:Z
# Service account authentication: choose ONE of these
# GSHEETS_CREDENTIALS_FILE=/run/secrets/gsheets-service-account.json
# or
# GSHEETS_CREDENTIALS_JSON={"type":"service_account", ...}

## Crawler (domain discovery pipeline)
# Set CRAWLER_ENABLED=0 to disable scheduled discovery
CRAWLER_ENABLED=1
CRAWLER_DISCOVERY_INTERVAL_SECONDS=43200
CRAWLER_MAX_DOMAINS_PER_RUN=500
CRAWLER_MIN_SCORE_THRESHOLD=40
CRAWLER_RATE_LIMIT_SECONDS=1.5

# Crawl sessions (bounded discovery windows)
CRAWLER_SESSION_ENABLED=1
CRAWLER_SESSION_MAX_DOMAINS_PER_CYCLE=50
CRAWLER_SESSION_CYCLE_INTERVAL_SECONDS=600
CRAWLER_SESSION_MAX_ACTIVE_PER_USER=1
CRAWLER_SESSION_MIN_DURATION_MINUTES=15
CRAWLER_SESSION_PROGRESS_NOTIFY_MINUTES=120
CRAWLER_SESSION_PROGRESS_MIN_DURATION_MINUTES=360
CRAWLER_SCHEDULE_CHECK_INTERVAL_SECONDS=300
CRAWLER_SCHEDULE_DEFAULT_SESSION_MINUTES=360
CRAWLER_SCHEDULE_MIN_INTERVAL_MINUTES=60
CRAWLER_SCHEDULE_MAX_INTERVAL_MINUTES=10080

# Geographic scope for AI search, discovery, and event/tender filtering.
# east_africa = strict (default); global = disable hard East Africa gate.
CRAWLER_GEO_MODE=east_africa
CRAWLER_DEFAULT_REGION=Kenya Uganda Tanzania Rwanda Burundi South Sudan Ethiopia East Africa EAC
# Set 0 to skip automatic Gemini competitor-keyword derivation on new CrawlSource rows.
CRAWLER_AUTO_DERIVE_COMPETITOR_SIGNALS=1

# Google Gemini (AI search page extraction, crawl analysis, grounded search fallback)
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_GROUNDED_MODEL=gemini-2.5-flash
GEMINI_GROUNDED_MAX_REMOTE_CALLS=5
# Minimum translation_need_score (0-100) to keep AI search results / allow promote
AI_SEARCH_MIN_SCORE=80
AI_SEARCH_PROMOTE_MIN_SCORE=80
# Require GEMINI_API_KEY for AI search jobs (recommended; set 0 for rules-only Serper mode)
AI_SEARCH_REQUIRE_GEMINI=1
# Require active tender/RFP/event hiring on page (not org homepages)
AI_SEARCH_REQUIRE_ACTIVE_BUYER=1
# Max Gemini extractions per job (quota control)
AI_SEARCH_MAX_GEMINI_EXTRACTS=12
# Apply active-buyer + timeline rules to manual/crawler discovery preview (default on)
CRAWLER_REQUIRE_ACTIVE_BUYER=1

# Serper.dev Google Search API (optional). When set, manual keyword search and
# discovery use Google results instead of Bing scraping. Get key at https://serper.dev
SERPER_API_KEY=

## Ops endpoints
# Required for /ops/* endpoints. Requests must include header: X-OPS-TOKEN
OPS_TOKEN=change-me-too

## Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=0

## Production (HTTPS)
# DJANGO_DEBUG=0
# DJANGO_ENV=production
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# DJANGO_SECURE_SSL_REDIRECT=1   # if clients can reach Django over HTTP directly
