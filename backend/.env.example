## Django
DJANGO_ENV=development
# Use 1 for local runserver. If 0, SECURE_SSL_REDIRECT defaults to off but session cookies
# still default to Secure=True — use HTTP-only cookies locally or stay on DEBUG=1.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Only enable when users hit your app over HTTPS (or set 0 behind a TLS-terminating proxy).
# If this is 1 while you only run `runserver` on http://127.0.0.1:8000, the browser gets
# redirected to https://127.0.0.1:8000/... and the dev server will log TLS garbage errors.
DJANGO_SECURE_SSL_REDIRECT=0

# Comma-separated. With DJANGO_DEBUG=1, common Vite :5173 origins (http + https) are added
# for CSRF. Django HTTPS (runserver_plus) + SPA: set VITE_DJANGO_PROXY_TARGET in frontend/.env.
# Production / custom SPA port: set explicitly, e.g. https://app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

## Database
# Example (Postgres):
# DATABASE_URL=postgresql://user:pass@localhost:5432/date_scraping?sslmode=disable
DATABASE_URL=

## Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
SCRAPE_ALL_INTERVAL_SECONDS=300
PERFEX_SYNC_INTERVAL_SECONDS=60

## Perfex CRM
PERFEX_SYNC_ENABLED=0
PERFEX_BASE_URL=https://your-perfex.example.com
PERFEX_API_TOKEN=your-token
# Optional JSON dict to include Perfex-required fields (status/source/assigned etc)
# PERFEX_DEFAULTS_JSON={"status":"1","source":"2"}
PERFEX_DEFAULTS_JSON=
PERFEX_TIMEOUT_SECONDS=20

## Google Sheets
GSHEETS_ENABLED=1
GSHEETS_SPREADSHEET_ID=your-spreadsheet-id
GSHEETS_PROSPECTS_RANGE=Prospects!A:E
GSHEETS_LEADS_RANGE=Leads!A:Z
# Service account authentication: choose ONE of these
# GSHEETS_CREDENTIALS_FILE=/run/secrets/gsheets-service-account.json
# or
# GSHEETS_CREDENTIALS_JSON={"type":"service_account", ...}

## Crawler (domain discovery pipeline)
# Set CRAWLER_ENABLED=0 to disable scheduled discovery
CRAWLER_ENABLED=1
CRAWLER_DISCOVERY_INTERVAL_SECONDS=43200
CRAWLER_MAX_DOMAINS_PER_RUN=500
CRAWLER_MIN_SCORE_THRESHOLD=40
CRAWLER_RATE_LIMIT_SECONDS=1.5

# Serper.dev Google Search API (optional). When set, manual keyword search and
# discovery use Google results instead of Bing scraping. Get key at https://serper.dev
SERPER_API_KEY=

## Ops endpoints
# Required for /ops/* endpoints. Requests must include header: X-OPS-TOKEN
OPS_TOKEN=change-me-too

## Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=0

## Production (HTTPS)
# DJANGO_DEBUG=0
# DJANGO_ENV=production
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# DJANGO_SECURE_SSL_REDIRECT=1   # if clients can reach Django over HTTP directly
