# Leave empty for relative URLs (Vite dev proxy, or Django serving the built SPA on the same host).
# Only set for a true cross-origin API, e.g. https://api.example.com
VITE_API_BASE=

# Django over TLS (e.g. `python manage.py runserver_plus --cert-file cert.pem`):
# VITE_DJANGO_PROXY_TARGET=https://127.0.0.1:8000
# Optional: match for “open admin” links from the SPA when not using the proxy
# VITE_API_BASE=https://127.0.0.1:8000
